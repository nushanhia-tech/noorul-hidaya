# ---------------------------------------------------------------
# Copy to .env.local for development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.
# ---------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY — bypasses RLS. Used for invitations, private file signed URLs,
# rate limiting and security logging. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the deployed site (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Online payments: none | sandbox | razorpay
#   none     → students are told to pay at the accounts office
#   sandbox  → clearly-labelled TEST mode; payments are stored as "sandbox" and never counted
#   razorpay → live gateway; signatures are verified server-side
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional email notifications via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="College Office <office@yourcollege.edu>"

# Protects /api/cron/daily (Vercel Cron sends it as a Bearer token)
CRON_SECRET=generate-a-long-random-string

# Scripts only (npm run seed): password for FICTIONAL demo accounts
SEED_PASSWORD=
# Tests only: local PostgreSQL for the database test-suite
TEST_DATABASE_URL=postgres://postgres@localhost:54329/college_test
